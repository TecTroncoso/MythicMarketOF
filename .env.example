# Configuración de Auth.js
AUTH_SECRET="escribe-un-secreto-largo-aqui" # usa `npx auth secret` para generarlo

# Variables de Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Configuración de Turso
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Configuración de Upstash Redis (Rate Limiting)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Configuración de Cloudflare Turnstile (Anti-Bot)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA" # Site key de prueba para pasar siempre
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA" # Secret key de prueba

# Scraper de precios Eneba (scrapers/eneba_mlbb.py / botón "Actualizar precios" del admin)
SCRAPINGANT_API_KEY=""
ENEBA_USER_ID="" # User ID de MLBB para simular el checkout
ENEBA_ZONE_ID="" # Zone ID de MLBB para simular el checkout

# Solo en local si el venv no se encuentra solo (poco frecuente)
# ENEBA_PYTHON_PATH="C:\\ruta\\a\\venv\\Scripts\\python.exe"

# Solo en Vercel: el botón dispara el workflow .github/workflows/scrape-prices.yml
# GITHUB_REPO="usuario/repo"
# GITHUB_TOKEN="" # PAT de GitHub con permiso actions:write sobre el repo
