# Configuración de Auth.js
AUTH_SECRET="escribe-un-secreto-largo-aqui" # usa `npx auth secret` para generarlo

# URL pública de la app. En Vercel Auth.js la detecta sola; fijala para que los
# enlaces del magic link apunten siempre al dominio final (no a un preview).
# AUTH_URL="https://mythicmarket.vercel.app"
# AUTH_TRUST_HOST="true"

# Variables de Google OAuth (opcionales: sin ellas el botón de Google no se
# registra ni se muestra en la UI).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Poné "true" para mostrar el botón de Google (requiere las dos variables de
# arriba con un cliente OAuth habilitado en Google Cloud Console).
NEXT_PUBLIC_GOOGLE_ENABLED="false"

# Magic link (login sin contraseña) vía Resend.
# Sin RESEND_API_KEY el provider Email no se registra.
RESEND_API_KEY=""
# Remitente. Para probar sirve el dominio compartido de Resend (solo llega al
# email de tu cuenta). En producción: "MythicMarket <no-reply@tudominio.com>"
# con el dominio verificado en https://resend.com/domains.
RESEND_FROM_EMAIL="MythicMarket <onboarding@resend.dev>"

# Configuración de Turso
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Configuración de Upstash Redis (Rate Limiting)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Configuración de Cloudflare Turnstile (Anti-Bot)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA" # Site key de prueba para pasar siempre
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA" # Secret key de prueba

# Scraper de precios Eneba (scrapers/eneba_mlbb.py / botón "Actualizar precios" del admin)
SCRAPINGANT_API_KEY=""
ENEBA_USER_ID="" # User ID de MLBB para simular el checkout
ENEBA_ZONE_ID="" # Zone ID de MLBB para simular el checkout

# Solo en local si el venv no se encuentra solo (poco frecuente)
# ENEBA_PYTHON_PATH="C:\\ruta\\a\\venv\\Scripts\\python.exe"

# Solo en Vercel: el botón dispara el workflow .github/workflows/scrape-prices.yml
# GITHUB_REPO="usuario/repo"
# GITHUB_TOKEN="" # PAT de GitHub con permiso actions:write sobre el repo
